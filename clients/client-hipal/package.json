{
	"name": "@hipal/client-hipal",
	"version": "0.1.2",
	"private": true,
	"scripts": {
		"dev": "next dev --port 3030",
		"build": "npm run build:prod",
		"start": "npm run start:prod ",
		"dev:qa": "env-cmd -f .env.qa next dev --port 4545",
		"start:qa": "env-cmd -f .env.qa next start --port 4545",
		"build:qa": "env-cmd -f .env.qa next build",
		"dev:prod": "env-cmd -f .env.prod next dev --port 4545",
		"start:prod": "env-cmd -f .env.prod next start",
		"build:prod": "env-cmd -f .env.prod next build",
		"update": "npx npm-check-updates -u && npm i",
		"update:force": "pnpx npm-check-updates -u && pnpm i -f",
		"lint": "eslint ./{assets,components,pages,public,styles}/**/*.{js,jsx,ts,tsx,css,md,json}",
		"lint:fix": "eslint --fix ./{assets,components,pages,public,styles}/**/*.{js,jsx,ts,tsx,css,md,json}",
		"format": "prettier --write ./{assets,components,pages,public,styles}/**/*.{js,jsx,ts,tsx,css,md,json} --config ./.prettierrc",
		"storybook": "start-storybook -p 6006",
		"build-storybook": "build-storybook",
		"analyze": "ANALYZE=true next build"
	},
	"dependencies": {
		"@headlessui/react": "^1.7.8",
		"@material-tailwind/react": "^1.2.5",
		"@next/bundle-analyzer": "^14.1.0",
		"@splidejs/react-splide": "^0.7.12",
		"@tanstack/react-query": "^5.40.1",
		"@tanstack/react-query-devtools": "^5.35.5",
		"axios": "^1.3.0",
		"build": "^0.1.4",
		"canvas-confetti": "^1.9.3",
		"daisyui": "^2.50.0",
		"env-cmd": "^10.1.0",
		"framer-motion": "^9.0.0",
		"lodash-es": "^4.17.21",
		"moment": "^2.29.4",
		"next": "13.1.6",
		"nextjs-progressbar": "^0.0.16",
		"npm": "^10.8.1",
		"postcss-flexbugs-fixes": "^5.0.2",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"react-icons": "^4.10.1",
		"react-insta-stories": "^2.4.2",
		"react-intersection-observer": "^9.4.1",
		"react-loading-skeleton": "^3.1.0",
		"react-query": "^3.39.3",
		"react-toastify": "^9.1.1",
		"run": "^1.5.0",
		"zustand": "^4.3.2"
	},
	"devDependencies": {
		"@babel/core": "^7.20.12",
		"@fullhuman/postcss-purgecss": "^5.0.0",
		"@next/bundle-analyzer": "^14.1.0",
		"@storybook/addon-essentials": "^6.5.16",
		"@storybook/addon-interactions": "^6.5.16",
		"@storybook/addon-links": "^6.5.16",
		"@storybook/builder-webpack5": "^6.5.16",
		"@storybook/react": "^6.5.16",
		"@tailwindcss/typography": "^0.5.9",
		"@types/lodash-es": "^4.17.6",
		"@types/react": "18.0.27",
		"autoprefixer": "^10.4.13",
		"eslint": "8.33.0",
		"eslint-config-next": "13.1.6",
		"eslint-config-prettier": "^8.6.0",
		"postcss": "^8.4.21",
		"postcss-preset-env": "^9.5.2",
		"prettier": "^2.8.3",
		"tailwindcss": "^3.4.1",
		"tsconfig-paths-webpack-plugin": "^4.0.0",
		"typescript": "4.9.5"
	}
}
