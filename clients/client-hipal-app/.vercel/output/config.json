{
  "version": 3,
  "routes": [
    {
      "src": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$",
      "headers": {
        "Location": "/$1"
      },
      "status": 308,
      "continue": true
    },
    {
      "src": "/_next/__private/trace",
      "dest": "/404",
      "status": 404,
      "continue": true
    },
    {
      "src": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(svg|jpg|png|ico|webp|woff|woff2|ttf|otf|eot|map|txt|xml)(?:/)?$",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/404/?",
      "status": 404,
      "continue": true,
      "missing": [
        {
          "type": "header",
          "key": "x-prerender-revalidate"
        }
      ]
    },
    {
      "src": "^/?",
      "has": [
        {
          "type": "header",
          "key": "rsc"
        }
      ],
      "dest": "/index.rsc",
      "headers": {
        "vary": "RSC, Next-Router-State-Tree, Next-Router-Prefetch"
      },
      "continue": true,
      "override": true
    },
    {
      "src": "^/((?!.+\\.rsc).+?)(?:/)?$",
      "has": [
        {
          "type": "header",
          "key": "rsc"
        }
      ],
      "dest": "/$1.rsc",
      "headers": {
        "vary": "RSC, Next-Router-State-Tree, Next-Router-Prefetch"
      },
      "continue": true,
      "override": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/index(\\.action|\\.rsc)",
      "dest": "/",
      "continue": true
    },
    {
      "src": "/_next/data/(.*)",
      "dest": "/_next/data/$1",
      "check": true
    },
    {
      "src": "^(?<rscsuff>\\.rsc)?(?:/)?$",
      "dest": "/index.html$rscsuff",
      "check": true
    },
    {
      "src": "/\\.prefetch\\.rsc$",
      "dest": "/__index.prefetch.rsc",
      "check": true
    },
    {
      "src": "/(.+)/\\.prefetch\\.rsc$",
      "dest": "/$1.prefetch.rsc",
      "check": true
    },
    {
      "src": "/\\.rsc$",
      "dest": "/index.rsc",
      "check": true
    },
    {
      "src": "/(.+)/\\.rsc$",
      "dest": "/$1.rsc",
      "check": true
    },
    {
      "handle": "resource"
    },
    {
      "src": "/.*",
      "status": 404
    },
    {
      "handle": "miss"
    },
    {
      "src": "/_next/static/(?:[^/]+/pages|pages|chunks|runtime|css|image|media)/.+",
      "status": 404,
      "check": true,
      "dest": "$0"
    },
    {
      "handle": "rewrite"
    },
    {
      "src": "/_next/data/(.*)",
      "dest": "/404",
      "status": 404
    },
    {
      "src": "^/n/(?<nxtPcustomLink>[^/]+?)(?:\\.rsc)(?:/)?$",
      "dest": "/n/[customLink].rsc?nxtPcustomLink=$nxtPcustomLink"
    },
    {
      "src": "^/n/(?<nxtPcustomLink>[^/]+?)(?:/)?$",
      "dest": "/n/[customLink]?nxtPcustomLink=$nxtPcustomLink"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/category(?:\\.rsc)(?:/)?$",
      "dest": "/r/[businessId]/category.rsc?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/category(?:/)?$",
      "dest": "/r/[businessId]/category?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/explore(?:\\.rsc)(?:/)?$",
      "dest": "/r/[businessId]/explore.rsc?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/explore(?:/)?$",
      "dest": "/r/[businessId]/explore?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/loyalty(?:\\.rsc)(?:/)?$",
      "dest": "/r/[businessId]/loyalty.rsc?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/loyalty(?:/)?$",
      "dest": "/r/[businessId]/loyalty?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/loyalty/(?<nxtPloyaltyId>[^/]+?)(?:\\.rsc)(?:/)?$",
      "dest": "/r/[businessId]/loyalty/[loyaltyId].rsc?nxtPbusinessId=$nxtPbusinessId&nxtPloyaltyId=$nxtPloyaltyId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/loyalty/(?<nxtPloyaltyId>[^/]+?)(?:/)?$",
      "dest": "/r/[businessId]/loyalty/[loyaltyId]?nxtPbusinessId=$nxtPbusinessId&nxtPloyaltyId=$nxtPloyaltyId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/payment(?:\\.rsc)(?:/)?$",
      "dest": "/r/[businessId]/payment.rsc?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/payment(?:/)?$",
      "dest": "/r/[businessId]/payment?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/review(?:\\.rsc)(?:/)?$",
      "dest": "/r/[businessId]/review.rsc?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/review(?:/)?$",
      "dest": "/r/[businessId]/review?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/user/otp(?:\\.rsc)(?:/)?$",
      "dest": "/r/[businessId]/user/otp.rsc?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/user/otp(?:/)?$",
      "dest": "/r/[businessId]/user/otp?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/user/signup(?:\\.rsc)(?:/)?$",
      "dest": "/r/[businessId]/user/signup.rsc?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "src": "^/r/(?<nxtPbusinessId>[^/]+?)/user/signup(?:/)?$",
      "dest": "/r/[businessId]/user/signup?nxtPbusinessId=$nxtPbusinessId"
    },
    {
      "handle": "hit"
    },
    {
      "src": "/_next/static/(?:[^/]+/pages|pages|chunks|runtime|css|image|media|KGkeoelygeMKDi05lldjs)/.+",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true,
      "important": true
    },
    {
      "src": "/index",
      "headers": {
        "x-matched-path": "/"
      },
      "continue": true,
      "important": true
    },
    {
      "src": "/((?!index$).*)",
      "headers": {
        "x-matched-path": "/$1"
      },
      "continue": true,
      "important": true
    },
    {
      "handle": "error"
    },
    {
      "src": "/.*",
      "dest": "/404",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/_error",
      "status": 500
    }
  ],
  "images": {
    "domains": [
      "picsum.photos",
      "pal-tribe.s3.ap-south-1.amazonaws.com",
      "dev.storage.hipal.life",
      "storage.hipal.life",
      "images.unsplash.com"
    ],
    "sizes": [
      640,
      750,
      828,
      1080,
      1200,
      1920,
      2048,
      3840,
      16,
      32,
      48,
      64,
      96,
      128,
      256,
      384
    ],
    "remotePatterns": [],
    "minimumCacheTTL": 31536000,
    "formats": [
      "image/webp"
    ],
    "dangerouslyAllowSVG": false,
    "contentSecurityPolicy": "script-src 'none'; frame-src 'none'; sandbox;",
    "contentDispositionType": "inline"
  },
  "overrides": {
    "404.html": {
      "path": "404",
      "contentType": "text/html; charset=utf-8"
    },
    "_app.rsc.json": {
      "path": "_app.rsc",
      "contentType": "application/json"
    },
    "_error.rsc.json": {
      "path": "_error.rsc",
      "contentType": "application/json"
    },
    "_document.rsc.json": {
      "path": "_document.rsc",
      "contentType": "application/json"
    },
    "404.rsc.json": {
      "path": "404.rsc",
      "contentType": "application/json"
    }
  },
  "framework": {
    "version": "14.2.3"
  },
  "crons": []
}
