{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    /* === Strictness === */
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    /* === Aliases === */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@api/*": ["src/api/*"],
      "@app/*": ["src/app/*"],
      "@asset/*": ["src/asset/*"],
      "@components/*": ["src/components/*"],
      "@config/*": ["src/config/*"],
      "@store/*": ["src/components/store/*"],
      "@hooks/*": ["src/components/hooks/*"],
      "@templates/*": ["src/components/templates/*"],
      "@utils/*": ["src/utils/*"],
      "@types/*": ["src/components/types/*"]
    },
    /* === Next.js plugin === */
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "build"]
}
